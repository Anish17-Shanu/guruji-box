{
  "rewrites": [
    {
      "source": "/api/api/:path*",
      "destination": "https://backend-gb-dusky.vercel.app/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://backend-gb-dusky.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
