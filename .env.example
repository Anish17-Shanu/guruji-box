# Copy this file to `.env` and change every secret before deploying.
# `.env` is ignored by git; never commit real credentials.

# --- Runtime -----------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# Public origin users open in the browser. Used for CORS and cookie safety.
# Include the scheme and port exactly as users type it.
PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080

# Comma-separated extra browser origins (for example a Vercel frontend).
EXTRA_ORIGINS=

# Host header allow-list. Use your public domain in production; `*` accepts any.
ALLOWED_HOSTS=*

# Leave empty for automatic mode: Secure cookies whenever APP_ENV=production.
# Set false ONLY when serving plain HTTP on localhost.
SECURE_COOKIES=

# --- Database ----------------------------------------------------------------
POSTGRES_DB=guruji
POSTGRES_USER=guruji
POSTGRES_PASSWORD=replace-with-a-long-random-password

# For non-Compose installs only; Compose builds this URL automatically.
# DATABASE_URL=postgresql+psycopg://guruji:password@host:5432/guruji

# --- Secrets -----------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_DAYS=7

# --- Content and accounts ----------------------------------------------------
# Runs the idempotent curriculum seed on container start. Demo accounts are
# never created when APP_ENV=production.
SEED_ON_START=true
SEED_DEMO=false
ALLOW_TEACHER_SIGNUP=true

# --- Tutor and worksheets (optional) ----------------------------------------
# Without a key, the tutor stays grounded in lesson text and worksheets use the
# deterministic generator. The key is server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend build ----------------------------------------------------------
# Leave empty when nginx proxies /api to the backend (default Compose setup).
# Set to an absolute API root only when the frontend is hosted separately.
VITE_API_URL=
VITE_SHOW_DEMO_HINTS=false
# Where the “Download installer” card points. Defaults to the GitHub releases page.
VITE_DESKTOP_DOWNLOAD_URL=

# --- Server tuning -----------------------------------------------------------
WEB_CONCURRENCY=2
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_TUTOR_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=600
