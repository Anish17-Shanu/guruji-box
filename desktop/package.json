{
  "name": "guruji-box-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "GURUJI BOX — offline AI learning centre for Windows",
  "main": "electron/main.js",
  "author": {
    "name": "Anish Kumar"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:frontend": "npm --prefix ../frontend run build",
    "build:backend": "cd ../backend && python -m PyInstaller --noconfirm --clean guruji_backend.spec",
    "build": "npm run build:frontend && npm run build:backend",
    "smoke": "node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  }
}
